{
  "name": "gx10-council-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "token-guard": "node scripts/token-guard.mjs",
    "check": "tsc --noEmit && biome check . && node scripts/token-guard.mjs && vitest run",
    "slice": "node scripts/slice.mjs",
    "look": "node scripts/look.mjs",
    "look:file": "node scripts/look-file.mjs",
    "contrast": "node scripts/contrast.mjs",
    "embed-fonts": "node scripts/embed-fonts.mjs",
    "gate": "npm run check && vite build && playwright test && node scripts/look-app.mjs --route \"#/review\" --name gate-review",
    "app": "vite build && env -u ELECTRON_RUN_AS_NODE electron .",
    "app:dev": "env -u ELECTRON_RUN_AS_NODE electron .",
    "look:app": "node scripts/look-app.mjs",
    "package:mac": "vite build && node scripts/package-mac.mjs",
    "review-sheet": "node scripts/review-sheet.mjs",
    "package:linux": "vite build && node scripts/package-linux.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@tanstack/react-query": "5.104.1",
    "clsx": "2.1.1",
    "lucide-react": "1.55.0",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "react-router": "8.4.0",
    "remark-gfm": "4.0.1",
    "remend": "1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.15",
    "@electron/packager": "20.3.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.0",
    "jsdom": "30.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "main": "electron/main.cjs",
  "productName": "GX10 Council"
}
